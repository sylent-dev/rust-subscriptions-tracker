   "boundElements": null,
   "updated": 1761231600000,
   "link": null,
   "locked": false,
   "text": "V6 · By category. Groups sorted by what they cost a month, each with its subtotal.\nBrings: where the money goes (the rent weighs 78 %). Costs: the nearest deadline is no\nlonger first; « Autre » holds the rent, since the list of categories has no « Logement ».",
   "originalText": "V6 · By category. Groups sorted by what they cost a month, each with its subtotal.\nBrings: where the money goes (the rent weighs 78 %). Costs: the nearest deadline is no\nlonger first; « Autre » holds the rent, since the list of categories has no « Logement ».",
   "fontSize": 14,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
