   "boundElements": null,
   "updated": 1761231600000,
   "link": null,
   "locked": false,
   "text": "V7 · By time. A strip of the next 60 days, then the subscriptions grouped by when to act.\nBrings: the rhythm of the deadlines in one look. Costs: the strip crowds when many\nfall the same week; a deadline in 8 months sits far down in « Plus tard ».",
   "originalText": "V7 · By time. A strip of the next 60 days, then the subscriptions grouped by when to act.\nBrings: the rhythm of the deadlines in one look. Costs: the strip crowds when many\nfall the same week; a deadline in 8 months sits far down in « Plus tard ».",
   "fontSize": 14,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25,
   "autoResize": true
